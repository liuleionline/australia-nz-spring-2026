# Copy this file to .env on the private server. Never commit real values.
PORT=8787
DATA_DIR=/var/lib/routebook-api
STATE_FILE=/var/lib/routebook-api/routebook-state.json
SESSION_DAYS=30

# Use only the public frontend origins that should call this API.
CORS_ORIGINS=https://example.github.io
ROUTEBOOK_ALLOWED_ORIGINS=https://example.github.io

# Required only when bootstrapping missing member accounts.
# Use a unique random value of at least 12 characters, then remove it after all accounts change password.
ROUTEBOOK_BOOTSTRAP_PASSWORD=replace-with-a-random-one-time-value

# Backups: keep credentials only on the server.
BACKUP_DIR=/var/lib/routebook-api/backups
MAX_BACKUPS=30
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-secret
BACKUP_WEBDAV_URL=https://example.invalid/dav/routebook
BACKUP_WEBDAV_USERNAME=replace-me
BACKUP_WEBDAV_PASSWORD=replace-me

# Optional external uploader.
BACKUP_UPLOAD_PROGRAM=
BACKUP_UPLOAD_ARGS_JSON=[]
