[Unit]
Description=Australia NZ Routebook API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=routebook
Group=routebook
WorkingDirectory=/opt/australia-nz-spring-2026/backend
EnvironmentFile=/etc/routebook-api.env
ExecStart=/usr/bin/node /opt/australia-nz-spring-2026/backend/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/routebook
UMask=0077

[Install]
WantedBy=multi-user.target
